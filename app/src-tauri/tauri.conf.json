{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "应聘避坑小工具",
  "version": "0.1.0",
  "identifier": "com.kd89.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "应聘避坑小工具",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "应聘公司收录、避坑评估与 AI 评分小工具",
    "longDescription": "收录应聘公司并管理岗位、薪资、沟通对话与投递记录，支持标签与风险标注、DeepSeek AI 综合评分、离线 OCR 识别与模糊搜索。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
